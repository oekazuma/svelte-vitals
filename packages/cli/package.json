{
  "name": "svelte-vitals",
  "version": "0.47.1",
  "description": "A deterministic SvelteKit code-health scanner (SEO, performance, correctness, security, architecture, accessibility).",
  "type": "module",
  "license": "MIT",
  "author": "Kazuma Oe (https://github.com/oekazuma)",
  "keywords": [
    "svelte",
    "sveltekit",
    "seo",
    "meta-tags",
    "cli",
    "svelte-vitals",
    "performance",
    "security",
    "code-quality",
    "static-analysis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oekazuma/svelte-vitals.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/oekazuma/svelte-vitals/issues"
  },
  "homepage": "https://github.com/oekazuma/svelte-vitals#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "sideEffects": false,
  "bin": {
    "svelte-vitals": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:rules-index": "pnpm --filter @svelte-vitals/core build && node scripts/gen-rules-index.mjs",
    "update-action-pin": "node scripts/gen-action-pin.mjs",
    "gen:docs": "node scripts/gen-docs.mjs",
    "gen:cli-reference": "pnpm --filter svelte-vitals... build && node scripts/gen-cli-reference.mjs"
  },
  "dependencies": {
    "@svelte-vitals/core": "workspace:*",
    "@clack/prompts": "catalog:",
    "@gunshi/plugin-completion": "catalog:",
    "@gunshi/plugin-i18n": "catalog:",
    "@gunshi/plugin-suggestion": "catalog:",
    "gunshi": "catalog:",
    "log-update": "catalog:",
    "magicast": "catalog:",
    "svelte": "catalog:",
    "tinyglobby": "catalog:"
  },
  "devDependencies": {
    "@gunshi/docs": "catalog:",
    "@types/estree": "catalog:",
    "@types/node": "catalog:"
  }
}
